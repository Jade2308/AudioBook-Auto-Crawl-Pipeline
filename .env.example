# Environment variables for AudioBook Auto Crawl Pipeline

# Target Website URL
SITE_BASE_URL=https://metruyenaudio.online

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Rclone Google Drive Destination Base
# Target structure: gdrive:Audiobooks/[Tên_Bộ_Truyện]/[File].m4a
RCLONE_REMOTE_BASE=gdrive:Audiobooks
RCLONE_TRANSFERS=4

# Directories & Files Config
TEMP_DIR=temp_downloads
HISTORY_FILE=history.txt

# VIP Account Authentication Cookie (Trích xuất từ F12 Trình duyệt để mở khóa full tập)
# Ví dụ: SESSION_COOKIE=token=xyz... hoặc auth_token=...
SESSION_COOKIE=

# Crawler Delay Settings (Seconds)
CRAWL_DELAY=3
MAX_STORIES_TO_CRAWL=0
MAX_PAGES_TO_CRAWL=0

