# Environment variables for AudioBook Auto Crawl Pipeline

# Target Website URL
SITE_BASE_URL=https://metruyenaudio.online

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# (Tùy chọn) Danh sách chat_id được phép điều khiển bot, phân cách bằng dấu phẩy.
# Nếu để trống, hệ thống sẽ dùng TELEGRAM_CHAT_ID ở trên.
# Ví dụ: TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=

# Rclone Google Drive Destination Base
# Target structure: gdrive:Audiobooks/[Tên_Bộ_Truyện]/[File].m4a
RCLONE_REMOTE_BASE=gdrive:Audiobooks
RCLONE_TRANSFERS=2

# Directories & Files Config
TEMP_DIR=temp_downloads
HISTORY_FILE=history.txt

# VIP Account Authentication Cookie (Trích xuất từ F12 Trình duyệt để mở khóa full tập)
# Ví dụ: SESSION_COOKIE=token=xyz... hoặc auth_token=...
SESSION_COOKIE=

# Crawler Delay Settings (Seconds)
CRAWL_DELAY=3
MAX_STORIES_TO_CRAWL=0
MAX_PAGES_TO_CRAWL=0

# Tự động tiếp tục chạy pipeline sau khi VPS / Bot khởi động lại (true/false)
AUTO_RESUME_ON_REBOOT=true

# Gửi tin nhắn Telegram thông báo Bot đã Online khi khởi động (true/false)
NOTIFY_ON_BOT_STARTUP=true

# Ngưỡng dung lượng tối thiểu của 1 tập audio hợp lệ (MB) - Dành cho file audio dài ~4 tiếng (mặc định: 20 MB)
MIN_AUDIO_FILE_SIZE_MB=20

# File cấu hình lịch chạy tự động qua Telegram Bot (mặc định: schedule_config.json)
SCHEDULE_CONFIG_FILE=schedule_config.json



